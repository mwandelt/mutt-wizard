# vim: filetype=neomuttrc
# muttrc file for account $fulladdr
set real_name = "$realname"
set from = "$fulladdr"
set sendmail = "msmtp -a $fulladdr"
alias me $realname <$fulladdr>
set folder = "$folder"
set header_cache = "$cachedir/$safename/headers"
set message_cache_dir = "$cachedir/$safename/bodies"
set mbox_type = Maildir
set hostname = "$hostname"
source $muttshare/switch.muttrc
set status_format = "──[ $fulladdr ]─%r─%D [Msgs:%<M?%M/>%m%<n? New:%n>%<o? Old:%o>%<d? Del:%d>%<F? Flag:%F>%<t? Tag:%t>%<p? Post:%p>%<b? Inc:%b>%<l? %l>]---(%<T?%T/>%s/%S)-%>-(%P)---"
set spool_file = "+INBOX"
set postponed = "+$draftsbox"
set trash = "+$trashbox"
set record = "+$sentbox"
set my_drafts = "+$draftsbox"
set my_junk = "+$junkbox"
set my_trash = "+$trashbox"
set my_sent = "+$sentbox"
set my_archive = "+$archivebox"
$extra
macro index o "<shell-escape>mailsync $fulladdr<enter>" "sync $fulladdr"
