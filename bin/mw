#!/bin/bash

set -a

prefix="/usr/local"
maildir="${XDG_DATA_HOME:-$HOME/.local/share}/mail"
muttshare="$prefix/share/mutt-wizard"
cachedir="${XDG_CACHE_HOME:-$HOME/.cache}/mutt-wizard"
muttrc="${XDG_CONFIG_HOME:-$HOME/.config}/mutt/muttrc"
accdir="${XDG_CONFIG_HOME:-$HOME/.config}/mutt/accounts"
unifiedmuttrc="${XDG_CONFIG_HOME:-$HOME/.config}/mutt/unified.muttrc"
# Only removed: where older versions of genunified kept identity copies.
identitydir="${XDG_CONFIG_HOME:-$HOME/.config}/mutt/identity"
identity="$prefix/lib/mutt-wizard/identity"
labelsmuttrc="${XDG_CONFIG_HOME:-$HOME/.config}/mutt/labels.muttrc"
unifiedstartupflag="${XDG_CONFIG_HOME:-$HOME/.config}/mutt/.unified-startup"
msmtprc="${XDG_CONFIG_HOME:-$HOME/.config}/msmtp/config"
msmtplog="${XDG_STATE_HOME:-$HOME/.local/state}/msmtp/msmtp.log"
mbsyncrc="${MBSYNCRC:-$HOME/.mbsyncrc}"
mpoprc="${XDG_CONFIG_HOME:-$HOME/.config}/mpop/config"
imapnotify="${XDG_CONFIG_HOME:-$HOME/.config}/imapnotify"
mpoptemp="$muttshare/mpop-temp"
mbsynctemp="$muttshare/mbsync-temp"
mutttemp="$muttshare/mutt-temp"
msmtptemp="$muttshare/msmtp-temp"
onlinetemp="$muttshare/online-temp"
notmuchtemp="$muttshare/notmuch-temp"
imapnotifytemp="$muttshare/imapnotify-temp"
# With the use of templates, it's impossible to use parameter substitution.
# Therefore, some default variables that might be otherwise overwritten are set
# here.
iport="993"
sport="465"
imapssl="IMAPS"
tlsline="tls_starttls off"
maxmes="0"
draftsbox="Drafts"
junkbox="Junk"
trashbox="Trash"
sentbox="Sent"
archivebox="Archive"

alias mbsync='mbsync -c "$mbsyncrc"'

# mbsync >=1.4.0 deprecates "Master/Slave" in favor of "Far/Near", and
# >=1.5.0 renames the "SSLType" IMAPStore keyword to "TLSType".
mbver="$(mbsync -v)"
mbver="${mbver#* }"
mbver="${mbver%.*}"
# Comparing two float numbers in bash is a pain in the butt, so we get rid of
# dots and turn them into nice integers
mbver="${mbver/\./}"
if [ "${mbver}" -ge 14 ]; then
	master="Far"
	slave="Near"
else
	master="Master"
	slave="Slave"
fi
if [ "${mbver}" -ge 15 ]; then
	tlstype="TLSType"
else
	tlstype="SSLType"
fi

for x in "/etc/ssl/certs/ca-certificates.crt" \
	"/etc/pki/tls/certs/ca-bundle.crt" "/etc/ssl/cert.pem" \
	"/etc/ssl/ca-bundle.pem" "/etc/pki/tls/cacert.pem" \
	"/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem" \
	"/usr/local/share/ca-certificates/"; do
	[ -f "$x" ] && sslcert="$x" && break
done || { echo "CA Certificate not found. Please install one or link it to /etc/ssl/certs/ca-certificates.crt" && exit 1; }

checkbasics() {
	command -V gpg >/dev/null 2>&1 && GPG="gpg" || GPG="gpg2"
	PASSWORD_STORE_DIR="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
	[ -r "$PASSWORD_STORE_DIR/.gpg-id" ] || {
		echo "First run \`pass init <yourgpgemail>\` to set up a password archive."
		echo "(If you don't already have a GPG key pair, first run \`$GPG --full-generate-key\`.)"
		exit 1
	}
}

getaccounts() { accounts="$(find -L "$accdir" -type f 2>/dev/null | grep -o "\S*.muttrc" | sed "s|.*/\([0-9]-\)*||;s/\.muttrc$//" | nl)"; }

list() { getaccounts && [ -n "$accounts" ] && echo "$accounts" || exit 1; }

prepmsmtp() {
	mkdir -p "${msmtprc%/*}" "${msmtplog%/*}"
	[ -f "$msmtprc" ] && echo >>"$msmtprc"
	envsubst <"$msmtptemp" >>"$msmtprc"
}

prepmbsync() {
	mkdir -p "${mbsyncrc%/*}"
	[ -f "$mbsyncrc" ] && echo >>"$mbsyncrc"
	envsubst <"$mbsynctemp" >>"$mbsyncrc"
}

prepmpop() {
	mkdir -p "${mpoprc%/*}"
	[ -f "$mpoprc" ] && echo >>"$mpoprc"
	envsubst <"$mpoptemp" >>"$mpoprc"
}

prepimapnotify() {
  mkdir -p "$imapnotify" ; envsubst < "$imapnotifytemp" >> "$imapnotify/$fulladdr.yaml"
}

prepmutt() {
	mkdir -p "${muttrc%/*}" "$accdir"
	envsubst <"$mutttemp" >"$accdir/$fulladdr.muttrc"
	[ ! -f "$muttrc" ] && echo "# vim: filetype=neomuttrc" >"$muttrc"
	! grep -q "^source.*mutt-wizard.muttrc" "$muttrc" && echo "source $muttshare/mutt-wizard.muttrc" >>"$muttrc"
	! grep "^source.*.muttrc" "$muttrc" | grep -qv "$muttshare/mutt-wizard.muttrc" && echo "source $accdir/$fulladdr.muttrc" >>"$muttrc"
	echo "macro index,pager i$idnum '<sync-mailbox><enter-command>source $accdir/$fulladdr.muttrc<enter><change-folder>!<enter>;<check-stats>' \"switch to $fulladdr\"" >>"$muttrc"
	neomutt -v | grep -q lmdb && ! grep -q "^set header_cache_backend.*lmdb" "$muttrc" && echo "set header_cache_backend = \"lmdb\"" >>"$muttrc"
	gssapitest="$(mktemp)"
	printf 'set smtp_authenticators = "gssapi:login"\n' >"$gssapitest"
	if neomutt -F "$gssapitest" -Q smtp_authenticators 2>/dev/null | grep -q gssapi; then smtpauth="gssapi:login"; else smtpauth="login"; fi
	rm -f "$gssapitest"
	! grep -q "^set smtp_authenticators" "$muttrc" && echo "set smtp_authenticators = '$smtpauth'" >>"$muttrc"
}

# Name of the neomutt variable holding an account's sidebar label in the
# unified overview: "my_label_" plus the address with everything but
# letters and digits turned into "_", since neomutt variable names can't
# contain "@" or ".".
labelvar() { printf 'my_label_%s' "$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_')"; }

# Regenerates $unifiedmuttrc from scratch: a named-mailboxes entry for every
# account's INBOX (whatever the account's own "set folder" resolved to, local Maildir or
# remote IMAP URL alike), plus a folder-hook that fixes up the account's
# identity (from/sendmail/folder/spool_file/...) the moment its tree is
# entered - without resetting the mailboxes list, so the overview stays in
# effect while reading mail. (Contrast with the full per-account "i<N>"
# macros, which source the account's own muttrc file directly and DO reset
# it - a deliberate full switch.) Entries are registered in "i<N>" order (not
# $accounts' arbitrary find(1) order) and labelled with their number, since
# neomutt's sidebar defaults to showing mailboxes in registration order -
# this way the overview visually lines up with the keys that jump to each
# account. Called after any change to the account list so the "iu" overview
# macro (wired into $muttrc below, once) always reflects the current
# accounts.
# The identity itself is not copied in here: the hooks pipe the account's
# muttrc through $identity every time they run, so edits to it take effect
# without rerunning mw.
# The sidebar label after the number is read from a $my_label_* variable
# (see labelvar) set in $labelsmuttrc, which belongs to the user: mw only
# appends a default (the full address) for accounts that don't have an
# entry yet and never rewrites existing ones, so labels edited there
# survive every regeneration. It is sourced from $unifiedmuttrc itself,
# right where the labels are needed - both "iu" and the startup load pick
# up an edit without rerunning mw.
genunified() {
	rm -rf "$identitydir"
	mkdir -p "${unifiedmuttrc%/*}"
	[ -f "$labelsmuttrc" ] || printf '%s\n' \
		'# vim: filetype=neomuttrc' \
		'# Sidebar labels for the unified inbox overview ("iu"), one per account.' \
		'# Edit the values freely; mw only adds entries for new accounts.' >"$labelsmuttrc"
	{
		echo "unhook folder-hook"
		echo "unhook account-hook"
		echo "unmailboxes *"
		echo "source \"$labelsmuttrc\""
		sed -n 's/^macro index,pager i\([0-9][0-9]*\) .*"switch to \(.*\)"$/\1 \2/p' "$muttrc" 2>/dev/null |
			sort -n -k1,1 | while read -r idnum addr; do
			[ -z "$addr" ] && continue
			acctfile="$accdir/$addr.muttrc"
			folder="$(sed -n 's/^set folder = "\(.*\)"$/\1/p' "$acctfile" | head -n1)"
			[ -z "$folder" ] && continue
			escfolder="$(printf '%s' "$folder" | sed 's/[.\\^$*[]/\\&/g')"
			# An online account's INBOX in the overview is connected to
			# without ever being entered - already while the named-mailboxes
			# line below is parsed, and later for the sidebar counts - so
			# the folder-hook below never runs for it, and neomutt would use
			# whatever imap_user/imap_pass the current account left behind
			# and prompt for the password. account-hook runs before every
			# connection to that account, but only if it is already defined
			# by then, hence it has to come first. neomutt matches it
			# against the login with a raw "@" (the URL has "%40") and may
			# omit the port, so the pattern accepts either.
			grep -qE '^set imap_(user|pass) = ' "$acctfile" &&
				printf "account-hook '%s' 'source \"%s -c %s |\"'\n" \
					"$(printf '%s' "$escfolder" | sed 's/%40/(%40|@)/; s/:\([0-9]*\)$/(:\1)?/')" \
					"$identity" "$acctfile"
			label="$(labelvar "$addr")"
			grep -q "^set $label = " "$labelsmuttrc" ||
				printf 'set %s = "%s"\n' "$label" "$addr" >>"$labelsmuttrc"
			printf 'named-mailboxes "%s $%s" "%s/INBOX"\n' "$idnum" "$label" "$folder"
			# No leading "^": neomutt treats a folder-hook pattern starting
			# with "^" as its own current-mailbox path shortcut rather than
			# a regex anchor, which errors out before regex matching ever
			# happens. The escaped absolute path is specific enough on its
			# own as an unanchored match.
			printf "folder-hook '%s/' 'source \"%s %s %s |\"'\n" \
				"$escfolder" "$identity" "$muttshare/switch.muttrc" "$acctfile"
		done
	} >"$unifiedmuttrc"
	mkdir -p "${muttrc%/*}"
	[ ! -f "$muttrc" ] && echo "# vim: filetype=neomuttrc" >"$muttrc"
	# Not sourced unconditionally: the default account's own muttrc is
	# already sourced at startup, and loading $unifiedmuttrc on top of that
	# would immediately unmailboxes its full folder list. Only the "iu"
	# macro below loads it, on demand.
	# Always rewritten (not just inserted-if-absent): unlike the per-account
	# lines above, this one's definition has kept changing, and a stale copy
	# from an older mw would otherwise never get updated again.
	sed -ibu "/^macro index,pager iu /d" "$muttrc" 2>/dev/null
	rm -f "$muttrc"bu
	# After loading the overview, "iu" opens the INBOX of the account the
	# current folder belongs to ("!" = $spool_file, which the account's own
	# muttrc or its identity file has set), so that INBOX is both shown and
	# highlighted in the sidebar. No leading <sync-mailbox> (unlike the
	# "i<N>" macros): with a message pending deletion, leaving the mailbox
	# raises a "purge deleted message?" prompt that swallows the macro's
	# remaining keystrokes - so the change of folder comes last, after the
	# overview has already been sourced, and the prompt just waits for the
	# user's answer.
	echo "macro index,pager iu '<enter-command>source $unifiedmuttrc<enter><change-folder>!<enter><check-stats>' \"unified inbox overview\"" >>"$muttrc"
	# "Load the unified view at startup" preference: $unifiedstartup, if the
	# caller set it (via "mw -U startup"/"mw -U nostartup"), turns it on/off
	# for good; otherwise keep whatever was set before, so a plain
	# "mw -a"/"-d"/"-r" (which all call this too) doesn't silently drop it.
	# Recorded in $unifiedstartupflag rather than by just checking whether
	# the muttrc currently has the line below: the account that used to be
	# default can be deleted (or reordered away), leaving nowhere to put
	# the line for a run or two, and the preference must survive that gap
	# rather than quietly reverting to "off".
	case "${unifiedstartup:-}" in
	startup) : >"$unifiedstartupflag" ;;
	nostartup) rm -f "$unifiedstartupflag" ;;
	esac
	sed -ibu "/# unified-startup$/d" "$muttrc" 2>/dev/null
	rm -f "$muttrc"bu
	if [ -f "$unifiedstartupflag" ]; then
		# Has to sit right after the default account's own
		# "source .../accounts/....muttrc" line, so that line's own
		# mailboxes get replaced by the unified list and not the other
		# way round. Marked with a trailing comment so it's
		# self-identifying and can be found and re-homed on every run.
		awk -v l="source $unifiedmuttrc # unified-startup" '
			{ print }
			/^source.*\/accounts\/.*\.muttrc$/ && !done { print l; done=1 }
		' "$muttrc" >"$muttrc.mwtmp" && mv "$muttrc.mwtmp" "$muttrc"
	fi
}

getprofiles() {
	safename="$(echo $fulladdr | sed 's/@/_/g')"
	case "$type" in
	online)
		# $login is itself an email address for most providers, so it
		# contains its own "@" - percent-encode it here so the URL's
		# user@host delimiter stays unambiguous (imap_user, set
		# separately in online-temp, keeps the unescaped address).
		folder="imaps://${login//@/%40}@$imap:$iport"
		extra="$(envsubst <"$onlinetemp")"
		# The Drafts/Trash/Sent defaults match a local Maildir (mbsync
		# always creates clean, unprefixed directories), but an online
		# account talks to the server directly, so use the wire name
		# getboxes() found for each role - including any namespace prefix.
		# Never emit the unprefixed default first and override it later:
		# neomutt resolves mailbox variables against the server as soon as
		# they're set, so even a transient wrong value produces an error.
		for role in drafts junk trash sent archive; do
			box="$(printf '%s\n' "$mailboxes" | awk -F'\t' -v r="$role" 'tolower($1)==r{print $2; exit}')"
			[ -n "$box" ] && printf -v "${role}box" '%s' "$box"
		done
		;;
	pop) prepmpop ;;
	*)
		case "$iport" in
		1143) imapssl=None ;;
		143) imapssl=STARTTLS ;;
		esac
		prepmbsync
		;;
	esac
	prepmsmtp
	prepmutt
	prepnotmuch
  prepimapnotify
}

parsedomains() {
	serverinfo="$(grep "^${fulladdr#*@}" "$muttshare/domains.csv" 2>/dev/null)"

	[ -z "$serverinfo" ] && serverinfo="$(grep "$(echo "${fulladdr#*@}" | sed "s/\.[^\.]*$/\.\\\*/")" "$muttshare/domains.csv" 2>/dev/null)"

	IFS=, read -r service imapsugg iportsugg smtpsugg sportsugg <<EOF
$serverinfo
EOF
	imap="${imap:-$imapsugg}"
	smtp="${smtp:-$smtpsugg}"
	sport="${sport:-$sportsugg}"
	iport="${iport:-$iportsugg}"
}

# Removes the "account $2" block from the msmtp/mpop-style config file $1,
# stopping at (without consuming) the next "account " line so a missing
# blank-line separator between blocks can never make this eat the next
# account's header line too.
delacctblock() {
	awk -v acct="account $2" '
		$0 == acct { skip=1; next }
		skip && /^account / { skip=0; print; next }
		skip && /^[ \t]*$/ { skip=0; next }
		skip { next }
		{ print }
	' "$1" >"$1.mwtmp" && mv "$1.mwtmp" "$1"
}

delete() {
	if [ -z "${fulladdr+x}" ]; then
		echo "Select the account you would like to delete (by number):"
		list || exit 1
		read -r input
		match="^\s*$input\s\+"
	else
		match="\s\+$fulladdr$"
		getaccounts
	fi

	fulladdr="$(echo "$accounts" | grep "$match" | grep -o "\S*@\S*")"

	[ -z "$fulladdr" ] && echo "$fulladdr is not a valid account name." && return 1

	sed -ibu "/IMAPStore $fulladdr-remote$/,/# End profile/d" "$mbsyncrc" 2>/dev/null
	rm -f "$mbsyncrc"bu
	safename="$(echo "$fulladdr" | sed 's/@/_/g')"
	rm -rf "${cachedir:?}/${safename:?}" "$accdir/$fulladdr.muttrc" "$accdir/"[0-9]-"$fulladdr.muttrc"
	sed -ibu "/\([0-9]-\)\?$fulladdr.muttrc/d" "$muttrc" 2>/dev/null
	rm -f "$muttrc"bu
	sed -ibu "/^set $(labelvar "$fulladdr") = /d" "$labelsmuttrc" 2>/dev/null
	rm -f "$labelsmuttrc"bu
	[ -f "$msmtprc" ] && delacctblock "$msmtprc" "$fulladdr"
	[ -f "$mpoprc" ] && delacctblock "$mpoprc" "$fulladdr"
	pass rm -f "$passprefix$fulladdr" >/dev/null 2>&1
	[ -n "${purge+x}" ] && rm -rf "${maildir:?}/${fulladdr:?}"
	genunified
}

askinfo() {
	[ -z "$fulladdr" ] && echo "Give the full email address to add:" &&
		read -r fulladdr
	while ! echo "$fulladdr" | grep -qE "^.+@.+\.[A-Za-z]+$"; do
		echo "$fulladdr is not a valid email address. Please retype the address:"
		read -r fulladdr
	done
	folder="$maildir/$fulladdr"
	getaccounts
	echo "$accounts" | grep -q "\s$fulladdr$" 2>/dev/null &&
		{ echo "$fulladdr has already been added" && exit 1; }
	{ [ -z "$imap" ] || [ -z "$smtp" ]; } && parsedomains
	[ -z "$imap" ] && echo "Give your email server's IMAP address (excluding the port number):" &&
		read -r imap
	[ -z "$smtp" ] && echo "Give your email server's SMTP address (excluding the port number):" &&
		read -r smtp
	case $sport in
	587) tlsline="# tls_starttls" ;;
	esac
	[ -z "$realname" ] && realname="${fulladdr%%@*}"
	[ -z "$passprefix" ] && passprefix=""
	hostname="${fulladdr#*@}"
	login="${login:-$fulladdr}"
	if [ -n "${password+x}" ] && [ ! -f "$PASSWORD_STORE_DIR/$passprefix$fulladdr.gpg" ]; then
		insertpass
	elif [ ! -f "$PASSWORD_STORE_DIR/$passprefix$fulladdr.gpg" ]; then
		getpass
    fi
}

insertpass() {
	printf "%s" "$password" | pass insert -fe "$passprefix$fulladdr"
}

errorexit() {
	echo "Log-on not successful."
	case "$imap" in
	imap.gmail.com)
		echo "This account with $service is using Google's Gmail servers, which disable all third-party applications without an application-specific password.
Please be sure you are using OAUTH with your Gmail account, or better yet, stop using Gmail."
		;;
	imap.mail.me.com)
		echo "This account with $service is using Apple's iCloud servers, which disable all non-Apple applications by default.
Please be sure you either enable third-party applications, or create an app-specific password, or best of all, stop using Apple."
		;;
	esac
	exit 1
}

getpass() { while :; do
	pass rm -f "$passprefix$fulladdr" >/dev/null 2>&1
	read -rsp "Password for $fulladdr: " password
	echo
	insertpass && break
done; }

getboxes() {
	# Each entry in $mailboxes is a "clean<TAB>wire" pair: the clean name has
	# any Courier/UW-IMAP-style "INBOX<delim>" namespace prefix stripped and
	# its delimiter normalized to "/" (used for sorting, the sidebar label,
	# and - for mbsync-backed accounts - the local Maildir layout); the wire
	# name is what must actually be SELECTed on the server. For mbsync-backed
	# (local) accounts the two are identical, since mbsync independently maps
	# the server's real name onto that same clean local directory name. For
	# "online" accounts there is no such intermediary, so the wire name keeps
	# the server's real prefix/delimiter intact.
	if [ -n "${force+x}" ]; then
		mailboxes="$(printf "INBOX\\nDrafts\\nJunk\\nTrash\\nSent\\nArchive" | awk '{print $0"\t"$0}')"
	else
		info="$(curl --proxy "$proxy" --location-trusted -s -m 5 --user "$login:$(pass "$passprefix$fulladdr")" --url "${protocol:-imaps}://$imap:${iport:-993}")"
		[ -z "$info" ] && errorexit
		# Some servers (mbox-based Courier/UW-IMAP-style setups) prefix every
		# personal folder with "INBOX<delim>" on the wire even though those
		# folders are not actually nested under INBOX. NAMESPACE reports that
		# prefix (if any); servers without NAMESPACE, or with an empty
		# personal-namespace prefix, are unaffected.
		nsline="$(curl --proxy "$proxy" --location-trusted -s -m 5 --user "$login:$(pass "$passprefix$fulladdr")" --url "${protocol:-imaps}://$imap:${iport:-993}" -X 'NAMESPACE' 2>/dev/null | grep '^\* NAMESPACE' | head -n1)"
		nsprefix="$(printf '%s\n' "$nsline" | sed -n 's/^\* NAMESPACE (("\([^"]*\)" *"[^"]*".*/\1/p')"
		# \Noselect marks folders that cannot hold mail (e.g. pure containers);
		# \HasChildren folders (e.g. "Archive" with subfolders) are kept, since
		# they can still contain mail of their own.
		mailboxes="$(echo "$info" | grep -v Noselect | tr -d '\r' | while IFS= read -r boxline; do
			delim="$(printf '%s\n' "$boxline" | sed -n 's/^\* LIST ([^)]*) "\{0,1\}\([^" ]*\)"\{0,1\} .*/\1/p')"
			name="$(printf '%s\n' "$boxline" | sed 's/.*\" //;s/\"//g')"
			clean="$name"
			[ -n "$nsprefix" ] && clean="${clean#"$nsprefix"}"
			if [ -n "$delim" ] && [ "$delim" != "NIL" ] && [ "$delim" != "/" ]; then
				delimesc="$(printf '%s' "$delim" | sed 's/[.\\^$*[]/\\&/g')"
				clean="$(printf '%s\n' "$clean" | sed "s#$delimesc#/#g")"
			fi
			[ "$type" = "online" ] && printf '%s\t%s\n' "$clean" "$name" || printf '%s\t%s\n' "$clean" "$clean"
		done)"
	fi
	[ "$type" = "pop" ] && mailboxes="$(printf 'INBOX\tINBOX')"
	# Order the sidebar sensibly: INBOX first, then the common function
	# folders in a fixed order, then everything else alphabetically - ranked
	# on the clean name so this is unaffected by a namespace prefix.
	mailboxes="$(printf '%s\n' "$mailboxes" | awk -F'\t' '
		{
			n = split($1, segs, "/")
			top = tolower(segs[1])
			if (top == "inbox")                    rank = 0
			else if (top == "drafts")               rank = 1
			else if (top == "sent")                 rank = 2
			else if (top == "junk" || top == "spam") rank = 3
			else if (top == "trash")                rank = 4
			else if (top == "archive" || top == "archives") rank = 5
			else if (top == "templates")            rank = 6
			else                                     rank = 9
			printf "%d\t%s\t%s\n", rank, tolower($1), $0
		}
	' | sort -t "$(printf '\t')" -k1,1n -k2,2 | cut -f3-)"
	# The server reports non-ASCII names in IMAP's modified UTF-7 (RFC 3501
	# 5.1.3). mbsync keeps that form on disk, so it's right for local
	# accounts - but neomutt expects IMAP paths in its config as UTF-8 and
	# encodes them itself, so an online account's wire name must be decoded
	# or it gets encoded twice ("&APw-" -> "&-APw-") and doesn't exist.
	[ "$type" = "online" ] && mailboxes="$(printf '%s\n' "$mailboxes" | perl -CS -MMIME::Base64 -ne '
		chomp;
		my ($clean, $wire) = split /\t/, $_, 2;
		$wire =~ s{&([^-]*)-}{
			my $b64 = $1;
			if ($b64 eq "") { "&" }
			else {
				(my $m = $b64) =~ tr{,}{/};
				$m .= "=" x ((4 - length($m) % 4) % 4);
				join("", map { chr($_) } unpack("n*", MIME::Base64::decode_base64($m)));
			}
		}gex;
		print "$clean\t$wire\n";
	')"
	for x in $(
		sed -n "/^macro.* i[0-9] / s/\(^macro.* i\| .*\)//gp " "$muttrc" 2>/dev/null | sort -u
		echo 0
	); do
		idnum=$((idnum + 1))
		[ "$idnum" -eq "$x" ] || break
	done
	# Servers commonly hand back non-ASCII folder names in IMAP's modified
	# UTF-7 (RFC 3501 5.1.3), and mbsync stores them on disk exactly as
	# received (Subfolders Verbatim). The "=..." path below must therefore
	# stay in that raw wire form (for online accounts it was decoded above,
	# since neomutt encodes it itself), but named-mailboxes lets us additionally
	# attach a decoded, human-readable label for the sidebar (%D) - just the
	# leaf segment, indented and prefixed with a tree connector to show its
	# nesting depth (the ancestors already have their own label line). Built
	# from the clean name, so an online account's namespace prefix never
	# leaks into the label.
	labels="$(printf '%s\n' "$mailboxes" | cut -f1 | perl -CS -MMIME::Base64 -ne '
		chomp;
		my @segs = split m{/}, $_, -1;
		my $depth = $#segs;
		my $s = $segs[-1];
		$s =~ s{
			& ([^-]*) -
		}{
			my $b64 = $1;
			if ($b64 eq "") { "&" }
			else {
				(my $m = $b64) =~ tr{,}{/};
				$m .= "=" x ((4 - length($m) % 4) % 4);
				my $bytes = MIME::Base64::decode_base64($m);
				join("", map { chr($_) } unpack("n*", $bytes));
			}
		}gex;
		my $prefix = $depth > 0 ? (" " x (1 + ($depth - 1) * 3)) . "\x{2514}\x{2500} " : "";
		print "$prefix$s\n";
	')"
	toappend="named-mailboxes $(paste -d' ' \
		<(echo "$labels" | sed "s/^/\"/;s/\$/\"/;s/'/\\\'/g") \
		<(echo "$mailboxes" | cut -f2 | sed "s/^/\"=/;s/\$/\"/;s/'/\\\'/g") |
		paste -sd' ' -)"
}

finalize() {
	echo "$toappend" >>"$accdir/$fulladdr.muttrc"
	[ "$type" != "online" ] && echo "$mailboxes" | cut -f1 | xargs -I {} mkdir -p "$maildir/$fulladdr/{}/cur" "$maildir/$fulladdr/{}/tmp" "$maildir/$fulladdr/{}/new"
	mkdir -p "$cachedir/$safename/bodies"
	genunified
	echo "$fulladdr (account #$idnum) added successfully."
	command -V urlview >/dev/null 2>&1 && [ ! -f "$HOME/.urlview" ] && echo "COMMAND \$BROWSER" >"$HOME/.urlview"
	return 0
}

prepnotmuch() {
	[ -z "$NOTMUCH_CONFIG" ] && NOTMUCH_CONFIG="$HOME/.notmuch-config"
	[ -f "$NOTMUCH_CONFIG" ] && return 0
	envsubst <"$notmuchtemp" >"$NOTMUCH_CONFIG"
}

togglecron() {
	cron="$(mktemp)"
	crontab -l >"$cron"
	if grep -q mailsync "$cron"; then
		echo "Removing automatic mailsync..."
		sed -ibu /mailsync/d "$cron"
		rm -f "$cron"bu
	else
		echo "Adding automatic mailsync every ${cronmin:-10} minutes..."
		echo "*/${cronmin:-10} * * * * $prefix/bin/mailsync" >>"$cron"
	fi &&
		crontab "$cron"
	rm -f "$cron"
}

setact() { if [ -n "${action+x}" ] && [ "$action" != "$1" ]; then
	echo "Running $1 with $action..."
	echo "Incompatible options given. Only one action may be specified per run."
	exit 1
else
	action="$1"
fi; }

mwinfo() {
	cat <<EOF
mw: mutt-wizard, auto-configure email accounts for mutt
including downloadable mail with \`isync\`.

Main actions:
  -a your@email.com	Add an email address
  -l			List email addresses configured
  -d			Remove an already added address
  -D your@email.com	Force remove account without confirmation
  -t number		Toggle automatic mailsync every <number> minutes
  -T			Toggle automatic mailsync
  -r			Reorder account numbers
  -U			Regenerate the "iu" unified inbox overview
  -U startup		...and also have neomutt open it at startup
  -U nostartup		...and have neomutt start in your default account again

Options allowed with -a:
  -u	Account login name if not full address
  -n	"Real name" to be on the email account
  -i	IMAP/POP server address
  -I	IMAP/POP server port
  -s	SMTP server address
  -S	SMTP server port
  -x	Password for account (recommended to be in double quotes)
  -p	Add for a POP server instead of IMAP.
  -P	Pass Prefix (prefix of the file where password is stored)
  -X	Delete an account's local email too when deleting.
  -o	Configure address, but keep mail online.
  -f	Assume typical English mailboxes without attempting log-on.
  -R	Use a proxy server for curl (useful for bypassing network restrictions)

NOTE: Once at least one account is added, you can run
\`mbsync -a\` to begin downloading mail.

To change an account's password, run \`pass edit '$passprefix'your@email.com\`.
EOF
}

reorder() {
	tempfile="$(mktemp -u)"
	trap 'rm -f $tempfile' HUP INT QUIT TERM PWR EXIT
	echo "# Carefully reorder these accounts with the desired numbers in the first column.
# DO NOT reorder rows or rename the accounts in the second column." >"$tempfile"
	sed -n "
	/ i[0-9] / s?\(.* i\|'<sync.*/\|\.muttrc.*\)??g p
	" "$muttrc" >>"$tempfile"
	${EDITOR:-vim} "$tempfile" || exit 1
	sed -i -e 's/#.*//' -e '/^$/d' "$tempfile"
	default="$(sort -n "$tempfile" | head -n 1)"
	default="${default#* }"
	sed -ibu "
  /.* i[0-9] .*.muttrc/d
  /^source.*accounts.*.muttrc/d
  " "$muttrc" 2>/dev/null
	rm -f "$muttrc"bu
	awk -v a="$accdir" -v d="$default" ' BEGIN { print "source "a"/"d".muttrc" }
		{
		print "macro index,pager i"$1" '\''<sync-mailbox><enter-command>source "a"/"$2".muttrc<enter><change-folder>!<enter>;<check-stats>'\'' \"switch to "$2"\""
		}
	' "$tempfile" >>"$muttrc"
}

while getopts "rfpXlhodTUYD:y:i:I:s:S:u:a:n:P:x:m:t:R:" o; do case "${o}" in
	l) setact list ;;
	r) setact reorder ;;
	R) proxy="$OPTARG" ;;
	d) setact delete ;;
	D)
		setact delete
		fulladdr="$OPTARG"
		;;
	y)
		setact sync
		fulladdr="$OPTARG"
		;;
	Y) setact sync ;;
	a)
		setact add
		fulladdr="$OPTARG"
		;;
	i)
		setact add
		imap="$OPTARG"
		;;
	I)
		setact add
		iport="$OPTARG"
		;;
	s)
		setact add
		smtp="$OPTARG"
		;;
	S)
		setact add
		sport="$OPTARG"
		;;
	u)
		setact add
		login="$OPTARG"
		;;
	n)
		setact add
		realname="$OPTARG"
		;;
	P)
		setact add
		passprefix="$OPTARG"
		;;
	m)
		setact add
		maxmes="$OPTARG"
		;;
	o)
		setact add
		type="online"
		;;
	p)
		setact add
		type="pop"
		protocol="pop3s"
		iport="${iport:-995}"
		;;
	f)
		setact add
		force=True
		;;
	x)
		setact add
		password="$OPTARG"
		;;
	X)
		setact delete
		purge=True
		;;
	t)
		setact toggle
		cronmin="$OPTARG"
		;;
	T) setact toggle ;;
	U)
		setact unified
		# getopts has no notion of an optional argument, so peek at the
		# next positional: "mw -U" alone (nothing there, or the next
		# option) just regenerates; "mw -U startup"/"mw -U nostartup"
		# additionally turns the "load unified view at startup"
		# preference on/off.
		case "${!OPTIND-}" in
		startup | nostartup)
			unifiedstartup="${!OPTIND}"
			OPTIND=$((OPTIND + 1))
			;;
		esac
		;;
	h) setact info ;;
	\?)
		echo "See \`$(basename $0) -h\` for possible options and help."
		exit 1
		;;
	esac done

[ -z "$action" ] && action="info"

case "$action" in
list) list ;;
add) checkbasics && askinfo && getboxes && getprofiles && finalize ;;
delete) delete ;;
sync)
	echo "\`mw -y\` and \`mw -Y\` are now deprecated and will be removed in a future update. Please switch to using \`mailsync\`."
	mailsync $fulladdr
	;;
toggle) togglecron ;;
reorder) reorder ;;
unified)
	genunified
	case "${unifiedstartup:-}" in
	startup) echo "Unified inbox overview regenerated; neomutt will now open it at startup." ;;
	nostartup) echo "Unified inbox overview regenerated; neomutt will start in your default account as before." ;;
	*) echo "Unified inbox overview (re)generated." ;;
	esac
	;;
info)
	mwinfo
	exit 1
	;;
esac
